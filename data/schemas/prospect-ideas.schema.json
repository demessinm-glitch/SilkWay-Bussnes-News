{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silkroadbrief.local/schemas/prospect-ideas.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "methodNoteZh", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "methodNoteZh": { "type": "string", "minLength": 20 },
    "items": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/idea" }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 5 }
    },
    "idea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "number",
        "titleZh",
        "subtitleZh",
        "hypothesis",
        "targetCustomers",
        "validationSteps",
        "risks",
        "chart",
        "flow",
        "ctaZh",
        "ctaSubject"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" },
        "number": { "type": "string", "pattern": "^IDEA [0-9]{2}$" },
        "titleZh": { "type": "string", "minLength": 5 },
        "subtitleZh": { "type": "string", "minLength": 10 },
        "hypothesis": { "type": "string", "minLength": 20 },
        "targetCustomers": { "$ref": "#/$defs/stringList" },
        "validationSteps": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 8 }
        },
        "risks": { "$ref": "#/$defs/stringList" },
        "chart": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "titleZh",
            "unitZh",
            "labels",
            "series",
            "assumptionsZh"
          ],
          "properties": {
            "kind": { "const": "scenario-not-forecast" },
            "titleZh": { "type": "string", "minLength": 5 },
            "unitZh": { "type": "string", "minLength": 4 },
            "labels": {
              "type": "array",
              "minItems": 3,
              "items": { "type": "string", "minLength": 2 }
            },
            "series": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["nameZh", "format", "values"],
                "properties": {
                  "nameZh": { "type": "string", "minLength": 3 },
                  "format": { "enum": ["integer", "decimal"] },
                  "values": {
                    "type": "array",
                    "minItems": 3,
                    "items": { "type": "number", "minimum": 0 }
                  }
                }
              }
            },
            "assumptionsZh": { "type": "string", "minLength": 20 }
          }
        },
        "flow": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["titleZh", "detailZh"],
            "properties": {
              "titleZh": { "type": "string", "minLength": 3 },
              "detailZh": { "type": "string", "minLength": 5 }
            }
          }
        },
        "ctaZh": { "type": "string", "minLength": 4 },
        "ctaSubject": { "type": "string", "minLength": 8 }
      }
    }
  }
}
