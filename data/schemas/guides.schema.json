{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silkroadbrief.local/schemas/guides.schema.json",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "titleZh",
          "summaryZh",
          "verificationStatus",
          "steps",
          "documents",
          "sourceUrl"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "titleZh": { "type": "string", "minLength": 2 },
          "summaryZh": { "type": "string", "minLength": 10 },
          "verificationStatus": { "enum": ["verified", "needs_review"] },
          "steps": { "type": "array", "minItems": 2 },
          "documents": { "type": "array", "minItems": 1 },
          "sourceUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
