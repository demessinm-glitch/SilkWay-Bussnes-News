{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silkroadbrief.local/schemas/prospects.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "scope",
    "national",
    "sources",
    "mapSource",
    "items"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regions", "citiesOfRepublicanSignificance"],
      "properties": {
        "regions": { "const": 17 },
        "citiesOfRepublicanSignificance": { "const": 3 }
      }
    },
    "national": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population",
        "populationPeriod",
        "populationPrevious",
        "populationPreviousPeriod",
        "annualChangePct",
        "averageMonthlyWage",
        "averageMonthlyWagePeriod",
        "medianMonthlyWage",
        "higherEducationStudents",
        "higherEducationInstitutions",
        "higherEducationPeriod"
      ],
      "properties": {
        "population": { "type": "integer", "minimum": 1 },
        "populationPeriod": { "const": "2026-01-01" },
        "populationPrevious": { "type": "integer", "minimum": 1 },
        "populationPreviousPeriod": { "const": "2025-01-01" },
        "annualChangePct": { "type": "number" },
        "averageMonthlyWage": { "type": "integer", "minimum": 1 },
        "averageMonthlyWagePeriod": { "const": "2026-Q1" },
        "medianMonthlyWage": { "type": "integer", "minimum": 1 },
        "higherEducationStudents": { "type": "integer", "minimum": 1 },
        "higherEducationInstitutions": { "type": "integer", "minimum": 1 },
        "higherEducationPeriod": { "const": "2025-2026" }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population",
        "populationPrevious",
        "wages",
        "higherEducation"
      ],
      "properties": {
        "population": { "$ref": "#/$defs/statUri" },
        "populationPrevious": { "$ref": "#/$defs/statUri" },
        "wages": { "$ref": "#/$defs/statUri" },
        "higherEducation": { "$ref": "#/$defs/statUri" }
      }
    },
    "mapSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "license", "licenseUrl", "note"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "license": { "type": "string", "minLength": 1 },
        "licenseUrl": { "type": "string", "format": "uri" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "items": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/unit" }
    }
  },
  "$defs": {
    "statUri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://stat\\.gov\\.kz/"
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "nameZh",
        "nameOriginal",
        "administrativeCenter",
        "population",
        "averageMonthlyWage",
        "higherEducation",
        "resources",
        "promisingSectors",
        "editorialNoteZh",
        "investmentProfileUrl",
        "map"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$" },
        "type": { "enum": ["region", "city"] },
        "nameZh": { "type": "string", "minLength": 2 },
        "nameOriginal": { "type": "string", "minLength": 2 },
        "administrativeCenter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nameZh", "nameLatin"],
          "properties": {
            "nameZh": { "type": "string", "minLength": 2 },
            "nameLatin": { "type": "string", "minLength": 2 }
          }
        },
        "population": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "period",
            "sourceUrl",
            "previousValue",
            "previousPeriod",
            "previousSourceUrl",
            "annualChangePct",
            "urbanSharePct"
          ],
          "properties": {
            "value": { "type": "integer", "minimum": 1 },
            "unit": { "const": "people" },
            "period": { "const": "2026-01-01" },
            "sourceUrl": { "$ref": "#/$defs/statUri" },
            "previousValue": { "type": "integer", "minimum": 1 },
            "previousPeriod": { "const": "2025-01-01" },
            "previousSourceUrl": { "$ref": "#/$defs/statUri" },
            "annualChangePct": { "type": "number" },
            "urbanSharePct": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "averageMonthlyWage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "unit", "period", "coverage", "sourceUrl"],
          "properties": {
            "value": { "type": "integer", "minimum": 1 },
            "unit": { "const": "KZT/month" },
            "period": { "const": "2026-Q1" },
            "coverage": { "type": "string", "minLength": 1 },
            "sourceUrl": { "$ref": "#/$defs/statUri" }
          }
        },
        "higherEducation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "institutions",
            "students",
            "period",
            "noteZh",
            "sourceUrl"
          ],
          "properties": {
            "kind": { "const": "talent-pool-proxy" },
            "institutions": { "type": "integer", "minimum": 1 },
            "students": { "type": "integer", "minimum": 1 },
            "period": { "const": "2025-2026" },
            "noteZh": { "type": "string", "minLength": 1 },
            "sourceUrl": { "$ref": "#/$defs/statUri" }
          }
        },
        "resources": { "$ref": "#/$defs/stringList" },
        "promisingSectors": { "$ref": "#/$defs/stringList" },
        "editorialNoteZh": { "type": "string", "minLength": 1 },
        "investmentProfileUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[a-z-]+\\.invest\\.gov\\.kz/"
        },
        "map": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pcode",
            "path",
            "centerX",
            "centerY",
            "markerX",
            "markerY"
          ],
          "properties": {
            "pcode": { "type": "string", "pattern": "^KZ[0-9]{2}$" },
            "path": { "type": "string", "pattern": "^M " },
            "centerX": { "type": "number", "minimum": 0, "maximum": 620 },
            "centerY": { "type": "number", "minimum": 0, "maximum": 340 },
            "markerX": { "type": "number", "minimum": 0, "maximum": 620 },
            "markerY": { "type": "number", "minimum": 0, "maximum": 340 }
          }
        }
      }
    }
  }
}
