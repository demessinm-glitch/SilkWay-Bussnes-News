{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silkroadbrief.local/schemas/cities.schema.json",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/city" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "city": {
      "type": "object",
      "required": [
        "id",
        "cityOriginal",
        "cityZh",
        "positionZh",
        "akimName",
        "akimNameZh",
        "addressOriginal",
        "addressZh",
        "phone",
        "websiteUrl",
        "profileSourceUrl",
        "contactSourceUrl",
        "verifiedAt"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "cityOriginal": { "type": "string", "minLength": 3 },
        "cityZh": { "type": "string", "minLength": 2 },
        "positionZh": { "type": "string", "minLength": 3 },
        "akimName": { "type": "string", "minLength": 3 },
        "akimNameZh": { "type": "string", "minLength": 2 },
        "addressOriginal": { "type": "string", "minLength": 8 },
        "addressZh": { "type": "string", "minLength": 8 },
        "phone": { "type": "string", "pattern": "^\\+7[0-9 ()-]+$" },
        "email": { "type": "string" },
        "websiteUrl": { "$ref": "#/$defs/httpsUrl" },
        "profileSourceUrl": { "$ref": "#/$defs/httpsUrl" },
        "contactSourceUrl": { "$ref": "#/$defs/httpsUrl" },
        "verifiedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
