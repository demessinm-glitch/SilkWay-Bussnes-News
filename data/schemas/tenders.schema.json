{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silkroadbrief.local/schemas/tenders.schema.json",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": ["string", "null"], "format": "date-time" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/tender" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "tender": {
      "type": "object",
      "required": [
        "id",
        "noticeNumber",
        "titleOriginal",
        "titleZh",
        "summaryZh",
        "buyerOriginal",
        "buyerZh",
        "regionZh",
        "methodOriginal",
        "methodZh",
        "budgetAmount",
        "currency",
        "budgetTextZh",
        "publishedAt",
        "applicationStart",
        "deadline",
        "status",
        "sourceName",
        "sourceUrl",
        "verifiedAt"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^goszakup-\\d+-\\d+$" },
        "noticeNumber": { "type": "string", "pattern": "^\\d+-\\d+$" },
        "titleOriginal": { "type": "string", "minLength": 5 },
        "titleZh": { "type": "string", "minLength": 4 },
        "summaryZh": { "type": "string", "minLength": 12 },
        "buyerOriginal": { "type": "string", "minLength": 8 },
        "buyerZh": { "type": "string", "minLength": 5 },
        "regionZh": { "type": "string", "minLength": 2 },
        "methodOriginal": { "type": "string", "minLength": 3 },
        "methodZh": { "type": "string", "minLength": 2 },
        "budgetAmount": { "type": "number", "minimum": 0 },
        "currency": { "const": "KZT" },
        "budgetTextZh": { "type": "string", "minLength": 5 },
        "publishedAt": { "type": "string", "format": "date-time" },
        "applicationStart": { "type": "string", "format": "date-time" },
        "deadline": { "type": "string", "format": "date-time" },
        "status": { "enum": ["open", "closing", "closed"] },
        "sourceName": { "type": "string", "minLength": 4 },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://goszakup\\.gov\\.kz/"
        },
        "verifiedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
